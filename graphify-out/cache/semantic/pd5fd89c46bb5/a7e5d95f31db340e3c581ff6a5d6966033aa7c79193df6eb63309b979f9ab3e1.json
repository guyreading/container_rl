ontainer_rl/env/container_rules.md", "source_location": "lines 158-179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official publisher errata from Kevin Nesbitt (game designer) clarifying the bank seizure procedure when a player cannot pay interest. Cascading asset seizure: Island Store \u2192 Harbour Store (2:1) \u2192 Factory Store (1:1) \u2192 Warehouse/Machine."}], "edges": [{"source": "container_rl_env_container_rules_loans", "target": "container_rl_env_container_rules_boardgame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_rules.md", "source_location": "line 44", "weight": 1.0}, {"source": "container_rl_env_container_rules_scoring", "target": "container_rl_env_container_rules_boardgame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_rules.md", "source_location": "line 21", "weight": 1.0}, {"source": "container_rl_env_container_rules_auction", "target": "container_rl_env_container_rules_boardgame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_rules.md", "source_location": "line 116", "weight": 1.0}, {"source": "container_rl_env_container_rules_domestic_sale", "target": "container_rl_env_container_rules_boardgame", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_rules.md", "source_location": "line 143", "weight": 1.0}, {"source": "container_rl_env_container_rules_interest_errata", "target": "container_rl_env_container_rules_loans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_rules.md", "source_location": "line 158", "weight": 1.0}], "hyperedges": []}