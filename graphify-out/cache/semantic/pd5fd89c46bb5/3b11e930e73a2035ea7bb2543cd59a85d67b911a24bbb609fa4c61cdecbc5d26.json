{"nodes": [{"id": "container_rl_env_readme_containerfunctional", "label": "ContainerFunctional", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure functional JAX design (jax.jit-compatible transition/observation/reward) enables GPU-accelerated RL training."}, {"id": "container_rl_env_readme_containerjaxenv", "label": "ContainerJaxEnv", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "container_rl_env_readme_actionencoder", "label": "ActionEncoder", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legacy encoder kept for backward compatibility so existing flat-index code continues to work alongside the new multi-head format."}, {"id": "container_rl_env_readme_envstate", "label": "EnvState", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "container_rl_env_readme_multihd_action_space", "label": "Multi-Head Action Space", "file_type": "concept", "source_file": "container_rl/env/README.md", "source_location": "line 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-head design chosen over flat index for: (1) generalisation \u2014 feedback on colour/price/opponent heads independently improves sample efficiency; (2) per-head action masks zero out invalid options before softmax so the agent never wastes time on illegal actions; (3) recurrent shopping (Option B) allows multiple purchases per action with summed log-probs matching PPO formula."}, {"id": "container_rl_env_readme_recurrent_shopping", "label": "Recurrent Shopping Mechanism", "file_type": "concept", "source_file": "container_rl/env/README.md", "source_location": "line 65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Option B design: actions 3 and 4 can buy multiple containers in a single action (matching real rules). After first purchase, shopping_active=True; training loop calls policy again for each subsequent purchase until STOP or constraints exhausted. Total log-prob for PPO = sum of all sub-step log-probs."}, {"id": "container_rl_env_readme_action_masks", "label": "Action Masks", "file_type": "concept", "source_file": "container_rl/env/README.md", "source_location": "line 90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-head binary masks appended to observation vector so policy can apply masked_logits = logits + log(mask) then softmax, ensuring illegal actions get zero probability."}, {"id": "container_rl_env_readme_observation", "label": "Observation Space", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 103", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "container_rl_env_readme_reward", "label": "Reward (Net Worth Delta)", "file_type": "code", "source_file": "container_rl/env/README.md", "source_location": "line 122", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "container_rl_env_readme_containerjaxenv", "target": "container_rl_env_readme_containerfunctional", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/README.md", "source_location": "line 21", "weight": 1.0}, {"source": "container_rl_env_readme_actionencoder", "target": "container_rl_env_readme_multihd_action_space", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "