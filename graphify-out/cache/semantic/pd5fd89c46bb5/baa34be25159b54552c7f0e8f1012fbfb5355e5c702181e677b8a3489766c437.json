{"nodes": [{"id": "container_rl_env_container_action_space_noop_masking", "label": "No-Op + Per-Mode Masking (v3)", "file_type": "concept", "source_file": "container_rl/env/container_action_space.md", "source_location": "lines 1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every head has no-op at index 0. In parallel mode (normal turn) no-op is masked out and all legal values shown. In sequential mode (shopping/produce continuation) irrelevant heads are forced to no-op; only relevant heads are active. This cleanly separates turn-level and sub-action choices."}, {"id": "container_rl_env_container_action_space_parallel_mode", "label": "Parallel Mode", "file_type": "concept", "source_file": "container_rl/env/container_action_space.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "container_rl_env_container_action_space_sequential_mode", "label": "Sequential Mode", "file_type": "concept", "source_file": "container_rl/env/container_action_space.md", "source_location": "line 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "container_rl_env_container_action_space_recurrent_produce", "label": "Recurrent Produce", "file_type": "concept", "source_file": "container_rl/env/container_action_space.md", "source_location": "lines 56-94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produce requires one initial entry step (pay $1 union boss, set produce_active=1) then one sequential step per factory to choose colour + price or leave idle. Turn advances only after all factories processed."}], "edges": [{"source": "container_rl_env_container_action_space_noop_masking", "target": "container_rl_env_readme_multihd_action_space", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "container_rl/env/container_action_space.md", "s