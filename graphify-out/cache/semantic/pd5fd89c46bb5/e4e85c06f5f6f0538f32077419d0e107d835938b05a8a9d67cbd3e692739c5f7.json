{"nodes": [{"id": "readme", "label": "Container RL Env README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_container_rl_env", "label": "Container RL Env", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulates the board game Container as an RL environment with JAX acceleration, enabling both human play via TUI and RL agent training. Supports single-player local TUI, multiplayer TCP server, recurrent multi-container actions, MaskablePPO action masking, and persistent SQLite game state."}, {"id": "readme_multiplayer_game_server", "label": "Game Server Architecture", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server owns game state and is authoritative \u2014 clients are thin terminals that render the board and send action indices. All game logic runs server-side via env.step(). Game state is persisted to SQLite after every action, supporting disconnection and rejoin. Communication happens over TCP with JSON messages."}, {"id": "readme_game_manager", "label": "Game Manager Component", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tcp_handler", "label": "TCP Handler Component", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sqlite_game_state", "label": "SQLite Persistent Game State", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Game state is persisted to SQLite after every action, enabling players to disconnect and rejoin mid-game using name and password. The database stores both state and player information on the server side."}, {"id": "readme_client_tui", "label": "Client TUI", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin client terminals that render the board state and send action indices to the server. Supports keyboard-driven controls for all game actions including buying, producing, loading ships, auctions, loans, and history browsing."}, {"id": "readme_maskableppo_action_masking", "label": "MaskablePPO Action Masking", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_recurrent_actions", "label": "Recurrent Multi-Container Actions", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actions like Produce, BuyFromFactory, and LoadShip support selecting multiple containers in a single turn, requiring recurrent action space handling for RL training."}, {"id": "readme_jax_gymnasium_env", "label": "JAX-Accelerated Gymnasium Environment", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zensical_docs_builder", "label": "Zensical Documentation Builder", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_github_pages_deployment", "label": "GitHub Pages Deployment", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": n